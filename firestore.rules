rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // System Settings (Only Admin can modify)
    match /system/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      // Allow read for layout and roles checking
      allow read: if isAuthenticated();
      
      // Users can modify their own record (for fallback create) OR admins can edit any
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Data Collections - Accessible by authenticated system users
    match /products/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /companies/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /receipts/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /debts/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /expenses/{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    // Fallback for any other collection
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
